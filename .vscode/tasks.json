{
  // 供 launch.json 的 preLaunchTask 使用，也可从「终端 → 运行任务」手动执行。
  // ui:dev / ui:build 对应 src-tauri/tauri.conf.json 的 build.beforeDevCommand / beforeBuildCommand。
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ui:dev",
      "detail": "只启动 Vite 开发服务器（http://localhost:1420），Tauri 应用交给调试器启动",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev", "--", "--clearScreen", "false"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      // 后台常驻任务：配合下面的 problemMatcher.background，
      // VS Code 会在 Vite 打印出「Local: http://localhost:1420/」后才启动调试器。
      // 注意此处只跑 `vite`，不能跑 `npm run tauri dev`：后者会自己编译并启动
      // target/debug 下的应用，和调试器启动的是同一份二进制、同一个窗口标识，
      // 结果是前台窗口属于 tauri dev 的进程，Rust 断点永远不命中。
      // 另外 --clearScreen false 防止 Vite 用清屏序列把横幅冲掉（否则匹配器扫不到那行）。
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "tauri",
        "clear": true
      },
      "problemMatcher": {
        "owner": "vite",
        "severity": "error",
        "pattern": {
          "regexp": "^\\s*(?:error|Error|ERROR)\\s*[:：]?\\s*(.+)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          // Vite 8 的启动横幅实际是带 ANSI 颜色、以 `\n  ` 开头的
          // `VITE v8.0.16  ready in 300 ms`，用 .* 兜住行首的转义与空白。
          "beginsPattern": ".*VITE\\s+v[\\d.]+.*",
          // Vite 8 打印的是 `  ➜  Local:   http://localhost:1420/`：
          // 行首是 ➜（\\s 不匹配它），`Local:` 后是 3 个空格，所以必须用 .* 前缀
          // 且不能把空格数写死。
          "endsPattern": ".*Local:\\s*https?://localhost:1420/?.*"
        }
      }
    },
    {
      "label": "ui:build",
      "detail": "前端生产构建（tsc 类型检查 + vite build）",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "tauri"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "cargo:build",
      "detail": "编译 Rust 后端（src-tauri）",
      "type": "shell",
      "command": "cargo",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "tauri"
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo:test",
      "detail": "运行 Rust 测试（含 tests/ffmpeg_probe.rs，需要本机 ffmpeg/ffprobe）",
      "type": "shell",
      "command": "cargo",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "tauri"
      },
      "problemMatcher": ["$rustc"]
    }
  ]
}
